# Create an OAuth 2.0 (3LO) app: https://developer.atlassian.com/console/myapps/
# Atlassian OAuth callback (must match PORT below): http://localhost:<PORT>/api/oauth/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Where the browser is opened after login (your Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Server port
PORT=3001

# Optional: force a site when the account has several (from accessible-resources, field "id")
# JIRA_CLOUD_ID=

# Time Doctor 2 API base (default: https://api2.timedoctor.com — TD2 REST API)
# TIMEDOCTOR_API_BASE=https://api2.timedoctor.com

# Session signing secret (any long random string in production)
SESSION_SECRET=change-me-in-production

# Persist sessions across server restarts (folder is created automatically)
# SESSION_STORE_PATH=/absolute/or/relative/path/to/session/files

# Cookie lifetime in days (rolling; extends on each API request when rolling is enabled)
SESSION_MAX_AGE_DAYS=90
